# AuraSmile OS — copy to `.env.local`
# App runs in demo mode without these keys (mock Indian clinic data).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# After keys are set:
# 1) Run SQL in supabase/migrations/ (in filename order) in the Supabase SQL Editor
# 2) Create an Auth user (app Sign up or Dashboard → Authentication)
# 3) Link user → clinic via clinic_members (see 20260915_seed_clinic_member.example.sql)
# 4) Sign in from the clinic login modal — patients/appointments sync live
# 5) Front desk → Clinic → Branding to upload letterhead logo (Storage bucket clinic-branding)
# 6) Doctor → Treat → Bill → Save receipt (clinical_receipts table)

# WhatsApp Cloud API (optional — wa.me fallback always works)
VITE_WHATSAPP_PHONE_ID=
VITE_WHATSAPP_CLINIC_E164=918025201234

# Sales contact for Enterprise / Multi-Chair (digits only, e.g. 9198xxxxxxxx).
# Without this, Pricing "Talk to sales" uses mailto:hello@aurasmile.clinic
# VITE_SALES_WHATSAPP=9198xxxxxxxx

# ABDM / ABHA M1-M2 sandbox (optional — UI labels stay demo-safe)
VITE_ABDM_CLIENT_ID=
VITE_ABDM_CLIENT_SECRET=

# Bolna AI telephony (optional — CRM uses mock call logs)
VITE_BOLNA_AGENT_ID=
VITE_BOLNA_API_KEY=

# n8n / automation webhook (optional — emitIntegrationEvent no-ops until set)
# VITE_INTEGRATIONS_WEBHOOK_URL=https://your-n8n.example/webhook/aurasmile
